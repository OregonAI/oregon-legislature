.venv/
_meta/.cache/
__pycache__/
site/
tests/
# NOTE: .git is deliberately NOT ignored — it is a RUNTIME dependency (the FTS cache key is
# `git rev-parse HEAD` + a hash of `git status --porcelain`, and corpus_overview() runs
# `git log -1`). Build from a depth-1 clone to keep it small; see the Dockerfile header.
# 422M, and NOT read at runtime. Snapshots are provenance evidence for
# corpus-verify-provenance; there is no reference to them anywhere under corpus_toolkit/mcp/.
# Consequence: that validator cannot run inside the container. It is a CI gate, run it there.
_meta/snapshots/

# Mounted at runtime from the host, not copied. The artifact is built out of band on a GPU
# machine; a git-clone build cannot see it anyway (gitignored), and COPYing it would put
# hundreds of MB of vectors into an image that reads them from a bind mount.
_meta/embeddings/
